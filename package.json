    "@sabaki/go-board": "1.4.3",
    "@sabaki/sgf": "3.5.0",
    "@sabaki/shudan": "1.8.0",
    "chess.js": "1.4.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "playwright": "1.60.0",
